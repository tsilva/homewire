// The network listener can start precisely one root-owned, fixed-action unit.
polkit.addRule(function(action, subject) {
    if (subject.user === "homewire-power" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "homewire-poweroff.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
